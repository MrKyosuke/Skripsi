<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/yellow"
    android:gravity="center_horizontal">

    <!-- Back Button -->

    <!-- Title at the top -->
    <ImageButton
        android:id="@+id/button_back"
        android:layout_width="59dp"
        android:layout_height="61dp"
        android:layout_gravity="start"
        android:adjustViewBounds="true"
        android:background="@null"
        android:contentDescription="Back"
        android:padding="4dp"
        android:scaleType="centerCrop"
        android:src="@drawable/back_button_red" />

    <TextView
        android:id="@+id/title_medium"
        android:layout_width="204dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@color/orange"
        android:text="Medium Level"
        android:textAlignment="center"
        android:textSize="25sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="44dp" />

    <!-- First CardView and Text -->
    <androidx.cardview.widget.CardView
        android:layout_width="220dp"
        android:layout_height="197dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white"
        android:clipChildren="true"
        android:clipToPadding="true">

        <ImageButton
            android:id="@+id/button_elephant"
            android:layout_width="match_parent"
            android:layout_height="256dp"
            android:adjustViewBounds="true"
            android:background="@null"
            android:contentDescription="Go to Easy Story"
            android:scaleType="centerCrop"
            android:src="@drawable/the_elephant_and_the_ant" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/text_elephant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="The Ant and The Elephant"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="italic" />

    <!-- Spacer for creating space -->
    <View
        android:layout_width="match_parent"
        android:layout_height="30dp" />

    <!-- Second CardView and Text -->
    <androidx.cardview.widget.CardView
        android:layout_width="220dp"
        android:layout_height="197dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white"
        android:clipChildren="true"
        android:clipToPadding="true">

        <ImageButton
            android:id="@+id/button_easy_story"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:background="@null"
            android:contentDescription="Go to Easy Story"
            android:scaleType="centerCrop"
            android:src="@drawable/fox_story" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/text_below_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="The Shepherd"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="italic" />

</LinearLayout>
