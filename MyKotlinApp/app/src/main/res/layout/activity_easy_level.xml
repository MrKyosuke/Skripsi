<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/yellow"
    android:gravity="center_horizontal">

    <!-- back button -->
    <ImageButton
        android:id="@+id/button_back"
        android:layout_width="59dp"
        android:layout_height="61dp"
        android:layout_gravity="start"
        android:adjustViewBounds="true"
        android:background="@null"
        android:contentDescription="Back"
        android:padding="4dp"
        android:scaleType="centerCrop"
        android:src="@drawable/back_button_red" />

    <!-- Title  -->
    <TextView
        android:id="@+id/title_easy"
        android:layout_width="204dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@color/limegreen"
        android:text="Easy Level"
        android:textAlignment="center"
        android:textSize="25sp"
        android:textStyle="bold" />

    <!-- Sementara padding pakai ini -->
    <View
        android:layout_width="match_parent"
        android:layout_height="44dp" />

    <!-- da turtle -->
    <androidx.cardview.widget.CardView
        android:layout_width="220dp"
        android:layout_height="197dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white"
        android:clipChildren="true"
        android:clipToPadding="true">

        <ImageButton
            android:id="@+id/button_turtle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:background="@null"
            android:contentDescription="Go to Easy Story"
            android:scaleType="centerCrop"
            android:src="@drawable/turtle_rabbit" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/text_turtle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="The Turtle and the Rabbit"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="italic" />

    <!-- padding yg sama kaya atas -->
    <View
        android:layout_width="match_parent"
        android:layout_height="30dp" />

    <!-- da shepherd jembod -->
    <androidx.cardview.widget.CardView
        android:layout_width="220dp"
        android:layout_height="197dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white"
        android:clipChildren="true"
        android:clipToPadding="true">

        <ImageButton
            android:id="@+id/button_shepherd"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:background="@null"
            android:contentDescription="Go to Easy Story"
            android:scaleType="centerCrop"
            android:src="@drawable/fox_story" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/text_below_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="The Shepherd"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="italic" />

</LinearLayout>
